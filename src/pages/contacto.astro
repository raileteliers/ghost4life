---
import Base from '../layouts/Base.astro';
import tienda from '../data/tienda.json';
import { ruta, whatsapp } from '../lib/format';

const direccionCompleta = `${tienda.direccion.calle}, ${tienda.direccion.comuna}, ${tienda.direccion.ciudad}`;
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccionCompleta)}`;

const motivos = [
  {
    titulo: 'Reservar un producto',
    texto: 'Dinos qué carta o producto quieres y te lo guardamos 48 horas.',
    cta: 'Reservar',
    mensaje: '¡Hola Ghost4Life! Quiero reservar un producto del catálogo.',
  },
  {
    titulo: 'Inscribirme en un torneo',
    texto: 'Indícanos la fecha y te confirmamos el cupo por mensaje.',
    cta: 'Inscribirme',
    mensaje: '¡Hola! Quiero inscribirme en un torneo. ¿Qué fechas tienen disponibles?',
  },
  {
    titulo: 'Vender o cambiar cartas',
    texto: 'Compramos colecciones y singles. Cuéntanos qué tienes y lo cotizamos.',
    cta: 'Cotizar',
    mensaje: '¡Hola! Quiero vender/cambiar cartas. ¿Cómo funciona la cotización?',
  },
  {
    titulo: 'Buscar una carta puntual',
    texto: '¿No la ves en el catálogo? Puede estar en vitrina o la conseguimos.',
    cta: 'Preguntar',
    mensaje: '¡Hola! Estoy buscando una carta que no encontré en el catálogo: ',
  },
];
---

<Base
  titulo="Contacto"
  descripcion={`Escríbenos por WhatsApp o pasa por ${direccionCompleta}. Reservas, inscripciones a torneos, compra de colecciones y búsqueda de cartas.`}
>
  <section class="contenedor cabecera-pagina">
    <h1>Contacto</h1>
    <p class="apagado intro">
      La vía más rápida es WhatsApp: respondemos en horario de tienda, de martes a
      domingo entre 13:00 y 21:30.
    </p>
  </section>

  <section class="contenedor">
    <div class="motivos">
      {motivos.map((m) => (
        <div class="motivo tarjeta">
          <h2>{m.titulo}</h2>
          <p class="apagado">{m.texto}</p>
          <a class="boton boton--secundario" href={whatsapp(m.mensaje)} target="_blank" rel="noopener">
            {m.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="contenedor seccion">
    <div class="canales">
      <div class="canal tarjeta">
        <h2>Datos directos</h2>
        <dl>
          <div>
            <dt>WhatsApp</dt>
            <dd>
              <a href={whatsapp('¡Hola Ghost4Life!')} target="_blank" rel="noopener">
                {tienda.whatsappLegible}
              </a>
            </dd>
          </div>
          <div>
            <dt>Correo</dt>
            <dd><a href={`mailto:${tienda.email}`}>{tienda.email}</a></dd>
          </div>
          <div>
            <dt>Dirección</dt>
            <dd><a href={mapa} target="_blank" rel="noopener">{direccionCompleta}</a></dd>
          </div>
          <div>
            <dt>Horario</dt>
            <dd>Martes a domingo, 13:00 – 21:30 · Lunes cerrado</dd>
          </div>
        </dl>
      </div>

      <div class="canal tarjeta">
        <h2>Redes</h2>
        <p class="apagado">
          Publicamos ingresos de stock, resultados de torneos y contenido de
          Yu-Gi-Oh! Lo que llega nuevo suele anunciarse primero acá.
        </p>
        <ul class="redes">
          {tienda.redes.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener">
                <strong>{r.nombre}</strong>
                <span class="apagado">{r.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="contenedor seccion">
    <p class="apagado pie-nota">
      ¿Buscas algo del catálogo? Míralo en <a href={ruta('/catalogo')}>Catálogo</a> y
      usa el botón de reserva de cada producto: nos llega el nombre y el precio ya
      escritos, y evitamos ir y venir.
    </p>
  </section>
</Base>

<style>
  .cabecera-pagina { padding-block: 2.5rem 1.5rem; }
  .cabecera-pagina h1 { margin-bottom: 0.35rem; }
  .intro { max-width: 56ch; margin: 0; }

  .motivos {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .motivo {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .motivo h2 { font-size: 1.0625rem; margin: 0; }
  .motivo p { font-size: 0.9375rem; margin: 0; flex: 1; }
  .motivo .boton { margin-top: 0.85rem; }

  .canales {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .canal { padding: 1.75rem; }
  .canal h2 { font-size: 1.125rem; margin-bottom: 1rem; }

  .canal dl { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .canal dl div { display: flex; flex-direction: column; gap: 0.15rem; }
  .canal dt {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }
  .canal dd { margin: 0; font-weight: 600; }

  .redes { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .redes li { border-top: 1px solid var(--border); }
  .redes a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    text-decoration: none;
  }
  .redes a:hover strong { text-decoration: underline; }
  .redes strong { color: var(--text); font-weight: 600; }

  .pie-nota { max-width: 65ch; font-size: 0.9375rem; }
</style>
